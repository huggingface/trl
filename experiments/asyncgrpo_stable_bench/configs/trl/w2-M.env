# W2-M run shape, decided from the 9B probe (trl-w2probe-M-probe-364979) and read by launch/trl/w2.sbatch at job start.
# A 9B episode on the probe tasks: ~23 turns, ~33k tokens of final context. terminus-2 + the Qwen3.5 template re-render
# the history every turn (OpenEnv: per_turn_capture_only), so each turn is its own sample and the turns of an episode
# share their prefix: ~45k unique tokens per episode when its turns land in the same packed row. 4 rows x 65,536 x ~0.8
# fill ~= 210k unique tokens per micro-batch ~= 4.5 episodes, so 14 micro-batches ~= 64 episodes (8 tasks x 8).
SPLIT=train
GRAD_ACCUM=14
TOKEN_BUDGET=65536
MAX_STEPS=60
SAVE_STEPS=20

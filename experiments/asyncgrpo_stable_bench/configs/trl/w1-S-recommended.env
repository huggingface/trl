# W1-S recommended arm: AsyncGRPOTrainer defaults on main for the ALGORITHM only (loss, advantage, sampler logprobs).
# Sourced by launch/trl/w1.sbatch when ARM=recommended; w1-S.py reads ARM=recommended for the rest:
#   score_centering=True (trainer default) instead of the clipped objective, epsilon_high unset,
#   advantages (r - mean) / (std + 1e-8) (trainer default) instead of r - mean.
# Batching is NOT an algorithm default (gradient_accumulation_steps x token_budget is a user choice), so it is identical
# to the shared arm: 16 micro-batches of 49152-token rows per step (changed 2026-11-10; run 364705 used token_budget
# default 18432 with GRAD_ACCUM=43, which cost extra micro-steps and packing time).
TOKEN_BUDGET=49152
GRAD_ACCUM=16
